# Port the tablet opens: http://<server-ip>:<DASHBOARD_PORT>
DASHBOARD_PORT=8088

# Your timezone, so "today", school days and lunch prep line up with your house
TZ=America/Chicago

# Google Calendar > Settings > (your calendar) > Integrate calendar > "Secret address in iCal format"
CAL_JAREN_ICS=https://calendar.google.com/calendar/ical/REPLACE_ME/private-REPLACE_ME/basic.ics
CAL_MOM_ICS=https://calendar.google.com/calendar/ical/REPLACE_ME/private-REPLACE_ME/basic.ics

# Ollama running on the same server (outside Docker)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=hermes3
